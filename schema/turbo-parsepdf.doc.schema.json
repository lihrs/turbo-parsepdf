{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/miaskiewicz/turbo-parsepdf/schema/turbo-parsepdf.doc.schema.json",
  "title": "turbo-parsepdf extracted document",
  "description": "The JSON shape produced by Document::extract -> ExtractedDoc::to_json.",
  "type": "object",
  "required": ["version", "pages"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "The PDF version from the file header (e.g. \"1.7\")."
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/definitions/page" }
    }
  },
  "definitions": {
    "page": {
      "type": "object",
      "required": ["width", "height", "lines", "needs_ocr", "tables", "images"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "description": "Media-box width in PDF points." },
        "height": { "type": "number", "description": "Media-box height in PDF points." },
        "needs_ocr": {
          "type": "boolean",
          "description": "True when the page had no extractable text (likely scanned; OCR is out of scope)."
        },
        "lines": {
          "type": "array",
          "items": { "$ref": "#/definitions/line" }
        },
        "tables": {
          "type": "array",
          "items": { "$ref": "#/definitions/table" }
        },
        "images": {
          "type": "array",
          "items": { "$ref": "#/definitions/image" },
          "description": "Extracted image XObjects with a browser-renderable data_url when available."
        }
      }
    },
    "line": {
      "type": "object",
      "required": ["text", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "description": "The reconstructed reading text of the line." },
        "x": { "type": "number", "description": "Device-space x of the line origin." },
        "y": { "type": "number", "description": "Device-space y of the line origin (PDF y grows upward)." }
      }
    },
    "table": {
      "type": "object",
      "required": ["rows", "cols", "cells"],
      "additionalProperties": false,
      "properties": {
        "rows": { "type": "integer", "minimum": 0 },
        "cols": { "type": "integer", "minimum": 0 },
        "cells": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["name", "format", "width", "height", "bits_per_component", "color_space", "data_url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "format": { "type": "string", "enum": ["Jpeg", "Jpeg2000", "Ccitt", "Jbig2", "Raw"] },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "bits_per_component": { "type": "integer", "minimum": 0 },
        "color_space": { "type": "string" },
        "data_url": {
          "type": "string",
          "description": "A data: URL or empty when not viewable."
        }
      }
    }
  }
}
